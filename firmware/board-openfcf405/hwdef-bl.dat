# hwdef-bl.dat — OPENFCF405 Bootloader (WeAct STM32F405RGT6)
# Target: ArduPilot Copter-4.6.3 / ChibiOS

MCU STM32F4xx STM32F405xx

APJ_BOARD_ID 9405

# confirmed_from_vendor_doc (WeAct-STM32F4_64PIN-CoreBoard_V11 SchDoc.pdf: X2 XTAL3225 8MHz +/-10ppm 10pF)
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# Bootloader lives at 0x08000000 (Sectors 0-1 = 32 KB); main firmware loads at 64 KB (Sector 4)
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 64

USB_STRING_MANUFACTURER "open-fc"
USB_STRING_PRODUCT "OPENFCF405-BL"

# USB OTG FS (PA9 is isolated from VBUS on WeAct F405)
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Keep SPI1 chip-select pins high while in bootloader
PA4  MPU6500_CS CS
PB12 BMP280_CS  CS

# FILL (M0-09): add verified WeAct F405 onboard LED pin here for bootloader heartbeat
