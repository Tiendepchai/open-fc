# OPEN-FC esp32-cam — Safe uncalibrated defaults (AGENTS.md §3.2)
# Intrinsics FX/FY default to 0 (uncalibrated): pipeline REFUSES to emit LANDING_TARGET
# until physical OV2640 calibration values are entered in untracked local sdkconfig (M3).
CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Candidate UART defaults matching OPENFCF405 SERIAL2 (USART2 / J_CAM @ 115200 bps)
CONFIG_OPENFC_CAM_UART_PORT=1
CONFIG_OPENFC_CAM_UART_BAUD=115200
CONFIG_OPENFC_CAM_UART_TX_GPIO=14
CONFIG_OPENFC_CAM_UART_RX_GPIO=15
CONFIG_OPENFC_CAM_MAX_FRAME_AGE_MS=150
CONFIG_OPENFC_CAM_MAV_SYS_ID=1
CONFIG_OPENFC_CAM_MAV_COMP_ID=191
CONFIG_OPENFC_CAM_FX_MILLIPX=0
CONFIG_OPENFC_CAM_FY_MILLIPX=0
