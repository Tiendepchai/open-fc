# OPEN-FC esp32-wifi — Tracked safe defaults (NO SECRETS — AGENTS.md §1.4)
# Override credentials ONLY in untracked local `sdkconfig` via `idf.py menuconfig`.
CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_HZ=1000
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Placeholder network settings (replace locally, never commit real SSID/PASS)
CONFIG_OPENFC_WIFI_SSID="OPENFC_AP_PLACEHOLDER"
CONFIG_OPENFC_WIFI_PASS="CHANGE_ME_LOCAL_ONLY"
CONFIG_OPENFC_GCS_IP="192.168.4.2"
CONFIG_OPENFC_GCS_UDP_PORT=14550
CONFIG_OPENFC_LOCAL_UDP_PORT=14550

# Candidate UART defaults matching OPENFCF405 SERIAL1 (USART1 / J_WIFI)
CONFIG_OPENFC_UART_PORT=2
CONFIG_OPENFC_UART_BAUD=921600
CONFIG_OPENFC_UART_TX_GPIO=17
CONFIG_OPENFC_UART_RX_GPIO=16
