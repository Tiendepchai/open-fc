	(text "SHEET 3: SENSORS (SPI1 IMU/BARO) & PERIPHERALS (GPS/I2C2, WIFI, CAM, TEST) — REV K 100% THT"
		(at 25.4 17.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "cfeabf47-73fc-4092-9c79-f1f166b8a6c6")
	)
	(text "NOTES:"
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.45 1.45)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3da993e8-702d-4ec9-8a49-f3749cc1dc03")
	)
	(text "1. MPU6500 (U2.9 NCS) & BMP280 (U3.5 CSB) measured ~9k pull-up -> NO ext CS pull-ups."
		(at 25.4 171.45 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "80c31d2b-526f-4b15-ad9e-3b7aaa8c1499")
	)
	(text "2. U2.10 FSYNC tied directly to GND; U2.5 (EDA) & U2.6 (ECL) flagged NC."
		(at 25.4 175.26 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "36fa57b7-833f-4c88-ba16-3158bba90276")
	)
	(text "3. BN-880 ~18k module I2C pull-up -> PCB adds R9/R10 4.7k to +3V3 for 400 kHz cable."
		(at 25.4 179.07 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "22a19704-59f7-4a2e-97e4-0e00a5706576")
	)
	(text "4. J_WIFI1 & J_CAM1: 1:+5V_COMP (pre-D1), 2:GND, 3:FC_TX, 4:FC_RX. PA9 isolated from VBUS."
		(at 25.4 182.88 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "41fabfe5-bba9-4a5b-af74-701f825916a9")
	)
